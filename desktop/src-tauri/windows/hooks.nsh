; BlueMolecule installer hooks (Tauri NSIS). "Open with > BlueMolecule" for chemistry files, for this user only.
; These are Open-with entries, never the default program: .log, .out and .inp files keep opening where they did.
; The list is the one of the 1.x Windows installer (native/windows/install.ps1).

!macro NSIS_HOOK_POSTINSTALL
  WriteRegStr HKCU "Software\Classes\BlueMolecule.Document" "" "BlueMolecule document"
  WriteRegStr HKCU "Software\Classes\BlueMolecule.Document\DefaultIcon" "" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr HKCU "Software\Classes\BlueMolecule.Document\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe" "FriendlyAppName" "BlueMolecule"
  WriteRegStr HKCU "Software\Classes\.log\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.out\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.xyz\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.gjf\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.inp\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.fchk\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.fch\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.cube\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.cub\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.molden\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.mol\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.sdf\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.mol2\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.pdb\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.ent\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.cif\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.mmcif\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.gro\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.cml\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.cjson\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.xsf\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.axsf\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.vasp\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.prmtop\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.parm7\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.inpcrd\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.rst7\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.psf\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.dcd\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.xtc\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.trr\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.nc\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.ncdf\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.ncrst\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.mdcrd\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.lammpstrj\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.pwi\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.pwo\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.cell\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.nw\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.mop\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.arc\OpenWithProgids" "BlueMolecule.Document" ""
  WriteRegStr HKCU "Software\Classes\.gz\OpenWithProgids" "BlueMolecule.Document" ""
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegValue HKCU "Software\Classes\.log\OpenWithProgids" "BlueMolecule.Document"
