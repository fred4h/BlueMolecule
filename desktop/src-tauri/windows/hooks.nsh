  DeleteRegValue HKCU "Software\Classes\.pdb\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.ent\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.cif\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.mmcif\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.gro\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.cml\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.cjson\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.xsf\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.axsf\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.vasp\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.prmtop\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.parm7\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.inpcrd\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.rst7\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.psf\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.dcd\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.xtc\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.trr\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.nc\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.ncdf\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.ncrst\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.mdcrd\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.lammpstrj\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.pwi\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.pwo\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.cell\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.nw\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.mop\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.arc\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegValue HKCU "Software\Classes\.gz\OpenWithProgids" "BlueMolecule.Document"
  DeleteRegKey HKCU "Software\Classes\BlueMolecule.Document"
  DeleteRegKey HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
